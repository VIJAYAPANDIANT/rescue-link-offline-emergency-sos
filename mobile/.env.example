# RescueLink Mobile Environment Configuration
#
# Configure backend API gateway URL:
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator / Web: http://localhost:5000/api
# - Physical Android Device (on same Wi-Fi): http://<YOUR_COMPUTER_LAN_IP>:5000/api
#   Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
#
EXPO_PUBLIC_API_URL=http://localhost:5000/api
